{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blurred-lines-entertainment",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ble-media"
    }
  ]
}
